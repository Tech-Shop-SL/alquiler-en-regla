# Copia este archivo a .env.local y rellena los valores. Antes de publicar: npm run check -- --prod

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Titular de la web (aviso legal, privacidad y condiciones; obligatorio por la LSSI)
LEGAL_NAME=
LEGAL_ID=
LEGAL_ADDRESS=
CONTACT_EMAIL=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (lectura de contratos en PDF)
ANTHROPIC_API_KEY=

# Stripe (usa claves de modo test mientras desarrollas)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Emails de alertas (Resend) y secreto del cron
RESEND_API_KEY=
ALERTS_FROM_EMAIL="Alquiler en Regla <avisos@tudominio.es>"
CRON_SECRET=

# Analítica de la landing con Plausible (opcional; sin cookies). Ej.: alquilerenregla.es
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Series del INE (opcional; solo si el INE cambia de base y dejan de llegar datos)
INE_SERIE_IPC=IPC290750
INE_SERIE_IRAV=IRAV1
